# Copy this file to helpers/.env (same folder), then fill in values.
#   cp helpers/.env.example helpers/.env
#
# Do NOT leave this INSTRUCTIONS line in helpers/.env.

# LLM provider used by LiteLLM (examples: groq, openai, ollama)
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq — get a key at https://console.groq.com/keys
GROQ_API_KEY=your-api-key-here

# Optional: override model name (provider-specific)
# LLM_MODEL=llama-3.1-8b-instant
